pipeline comissao_mensal inicio
    vendas = extrair de arquivocsv("/datalake/vendas.csv")
    vendedores = extrair de psql("select nome, sobrenome from vendedores where ativo = 1")

    comissoes = transformar vendas com operacao(valor * 5 / 100)
    nomes = transformar vendedores com concatenar(nome, sobrenome)

    se linhas(vendas) > 0 entao
        carregar comissoes em novo_banco("financeiro.comissoes_2026_09")
    senao
        carregar nomes em novo_csv("/datalake/alertas/sem_vendas_2026_09.csv")
    fimse
fim